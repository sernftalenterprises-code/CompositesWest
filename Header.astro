---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { company } from '../data/products';

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/our-products/', label: 'Our Products' },
  { href: '/all-products/', label: 'Shop Fabrics' },
  { href: '/hex-3r-products/', label: 'Hex-3R System' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <!-- Utility strip -->
  <div class="border-b border-line bg-paper text-stone-600">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-1.5 sm:px-6">
      <p class="eyebrow hidden sm:block">100,000 linear yd in stock — ships without lead time</p>
      <div class="eyebrow flex items-center gap-5">
        <a href={`tel:${company.phoneHref}`} class="transition-colors hover:text-ink-950">{company.phone}</a>
        <a href={`mailto:${company.email}`} class="hidden transition-colors hover:text-ink-950 md:block">{company.email}</a>
      </div>
    </div>
  </div>

  <!-- Main bar -->
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="Composites West home">
      <Image src={logo} alt="Composites West, Inc." class="h-9 w-auto" loading="eager" fetchpriority="high" width={168} densities={[1, 2, 3]} />
    </a>
    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class:list={[
            'relative py-2 font-display text-[13px] font-semibold uppercase tracking-[0.09em] transition-colors [font-variation-settings:"wdth"_110]',
            'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:bg-brand after:transition-transform after:duration-200',
            path === item.href
              ? 'text-ink-950 after:scale-x-100'
              : 'text-stone-500 after:scale-x-0 hover:text-ink-950 hover:after:scale-x-100',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact/" class="btn btn-primary ml-2 !px-4 !py-2.5">
        Request a Quote
      </a>
    </nav>
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center p-2 text-ink-950 hover:bg-paper lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open main menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav aria-label="Mobile" class="px-4 py-4">
      {nav.map((item, i) => (
        <a
          href={item.href}
          class="flex items-baseline gap-4 border-b border-line py-3.5 font-display text-base font-semibold uppercase tracking-[0.08em] text-ink-950 [font-variation-settings:'wdth'_110]"
        >
          {item.label}
        </a>
      ))}
      <a href="/contact/" class="btn btn-primary mt-4 w-full">
        Request a Quote
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
