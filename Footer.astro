---
import { company } from '../data/products';
const year = new Date().getFullYear();
---

<footer class="cv-auto relative border-t-2 border-brand bg-paper text-stone-600">
  <div class="frame-x relative mx-auto max-w-7xl px-4 sm:px-6">

    <div class="grid gap-12 py-16 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="font-display text-lg font-bold uppercase tracking-[0.06em] text-ink-950 [font-variation-settings:'wdth'_115]">
          Composites West, Inc.
        </p>
        <div class="tracer mt-4"></div>
        <p class="mt-5 max-w-sm text-sm leading-6">
          A reinforcement boutique since {company.founded}. Connecting aerospace, marine,
          automotive, sporting goods, and infrastructure customers to the right
          composite materials.
        </p>
      </div>

      <nav aria-label="Footer" class="md:col-span-2">
        <p class="eyebrow text-stone-500">Explore</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about/" class="underline-draw transition-colors hover:text-ink-950">About</a></li>
          <li><a href="/our-products/" class="underline-draw transition-colors hover:text-ink-950">Our Products</a></li>
          <li><a href="/all-products/" class="underline-draw transition-colors hover:text-ink-950">Shop Fabrics</a></li>
          <li><a href="/hex-3r-products/" class="underline-draw transition-colors hover:text-ink-950">Hex-3R System</a></li>
          <li><a href="/contact/" class="underline-draw transition-colors hover:text-ink-950">Contact</a></li>
        </ul>
      </nav>

      <nav aria-label="Hex-3R resources" class="md:col-span-3">
        <p class="eyebrow text-stone-500">Hex-3R Resources</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/specifications/" class="underline-draw transition-colors hover:text-ink-950">Specifications</a></li>
          <li><a href="/selection/" class="underline-draw transition-colors hover:text-ink-950">Resin Selection Guide</a></li>
          <li><a href="/general-installation-instructions/" class="underline-draw transition-colors hover:text-ink-950">Installation Instructions</a></li>
          <li><a href="/fibranchor-installation-instructions/" class="underline-draw transition-colors hover:text-ink-950">FibrAnchor Installation</a></li>
          <li><a href="/research/" class="underline-draw transition-colors hover:text-ink-950">Research</a></li>
        </ul>
      </nav>

      <div class="md:col-span-3">
        <p class="eyebrow text-stone-500">Contact</p>
        <address class="mt-4 space-y-4 font-mono text-[13px] not-italic leading-6">
          <p>
            <span class="text-ink-950">PHYSICAL</span><br />
            {company.physicalAddress.street}<br />
            {company.physicalAddress.city}, {company.physicalAddress.state} {company.physicalAddress.zip}
          </p>
          <p>
            <span class="text-ink-950">MAILING</span><br />
            {company.mailingAddress.street}<br />
            {company.mailingAddress.city}, {company.mailingAddress.state} {company.mailingAddress.zip}
          </p>
          <p>
            T <a href={`tel:${company.phoneHref}`} class="transition-colors hover:text-ink-950">{company.phone}</a><br />
            F {company.fax}<br />
            <a href={`mailto:${company.email}`} class="transition-colors hover:text-ink-950">{company.email}</a>
          </p>
        </address>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line py-5">
      <p class="eyebrow text-stone-500">&copy; {year} Composites West, Inc. All rights reserved.</p>
      <p class="eyebrow text-stone-500">EST. {company.founded} — RENO, NV</p>
    </div>
  </div>
</footer>
