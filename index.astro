---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';
import rolls from '../assets/rolls.jpg';
import carbonfiber from '../assets/carbonfiber.jpeg';

const featured = products.slice(0, 3);

const specialties = [
  { name: 'Carbon Fiber Fabrics', tag: '1K–12K tow' },
  { name: '±45 Knit Fabrics', tag: '103–408 gsm' },
  { name: 'Unidirectional (Hot Melt Fill)', tag: 'Continuous fiber' },
  { name: 'High Modulus Carbon Fabrics', tag: 'HR40 · IM' },
  { name: 'Aerospace Fiberglass', tag: 'Sourced to spec' },
  { name: 'Process Material Consumables', tag: 'Vacuum · Infusion' },
];

const stockedBrands = ['Hexcel', 'Toray', 'FCIM', 'CFA', 'T300', 'T700S', 'HR40', '3K · 6K · 12K'];

const faq = [
  {
    q: 'What materials does Composites West supply?',
    a: 'We specialize in carbon fiber fabric reinforcements — woven, non-crimp (knit), unidirectional, and braid — plus fiberglass, prepregs, core materials, vacuum bagging and infusion supplies. In-stock fabrics often include high modulus (HR40), intermediate modulus, and 1K, 3K, 6K, and 12K standard modulus materials.',
  },
  {
    q: 'How fast can you ship?',
    a: 'Our warehouse houses 100,000 linear yards of material ready to ship, so most in-stock orders go out without the long lead times typical of the composites industry.',
  },
  {
    q: 'Can you source materials that are not listed on the site?',
    a: 'Yes. We maintain relationships across the composites industry and regularly source hard-to-find reinforcements, prepregs, honeycomb core, and process materials to spec. Contact us with your requirements.',
  },
  {
    q: 'What industries do you serve?',
    a: 'Aerospace, marine, automotive, sporting goods, civil engineering and infrastructure, and industrial manufacturing — anywhere strength-to-weight matters.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

/* The hero figure only renders at lg and up, so serve a 1-pixel placeholder
   below 1024px instead of letting mobile download the hidden image. */
const rollsHero = await getImage({ src: rolls, widths: [700, 1100, 1600], format: 'webp' });

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Composites West, Inc.',
  url: 'https://compositeswest.com/',
};
---

<Base
  title="Composites West | Carbon Fiber Fabrics & Advanced Composite Materials"
  description="Composites West is a carbon fiber reinforcement boutique with 100,000 linear yards in stock, ready to ship. Carbon fiber fabrics, knits, unidirectional, fiberglass, and prepregs for aerospace, marine, automotive, and infrastructure."
  jsonLd={[websiteLd, faqLd]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-line bg-paper">
    <div
      class="absolute inset-0 -z-10 opacity-50 [background-image:linear-gradient(rgb(10_10_11/0.045)_1px,transparent_1px),linear-gradient(90deg,rgb(10_10_11/0.045)_1px,transparent_1px)] [background-size:64px_64px] [mask-image:linear-gradient(#000_55%,transparent_96%)]"
      aria-hidden="true"
    >
    </div>
    <div class="frame-x relative mx-auto max-w-7xl px-4 sm:px-6">

      <div class="grid items-center gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
        <div class="lg:col-span-7">
          <p class="eyebrow flex items-center gap-3 text-stone-500">
            <span class="inline-block h-0.5 w-8 bg-brand"></span>
            Composite reinforcements &middot; Est. 2001
          </p>
          <h1 class="type-display mt-6 text-5xl uppercase text-ink-950 sm:text-6xl lg:text-7xl">
            The right<br />materials.<br />
            <span class="-mx-2 inline-block bg-brand px-2">No lead time.</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-stone-600">
            Carbon fiber, fiberglass, and advanced reinforcements, matched to your
            application and shipped from 100,000 yards of stocked material.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/all-products/" class="btn btn-dark">
              Browse fabrics
            </a>
            <a href="/contact/" class="btn btn-outline">
              Request a quote
            </a>
          </div>
        </div>

        <figure class="relative hidden lg:col-span-5 lg:block">
          <picture>
            {/* srcset can't hold a data: URI (the comma reads as a candidate
                separator and the source gets discarded), hence the tiny file */}
            <source media="(max-width: 1023px)" srcset="/blank.svg" />
            <img
              src={rollsHero.src}
              srcset={rollsHero.srcSet.attribute}
              sizes="(min-width: 1024px) 42vw, 100vw"
              alt="Roll of 3K twill weave carbon fiber fabric with yellow tracer thread"
              width={rollsHero.attributes.width}
              height={rollsHero.attributes.height}
              class="img-fade aspect-[4/5] w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <figcaption class="eyebrow flex justify-between px-6 text-stone-500">
            <span>Carbon twill, 3K</span>
            <span>50&Prime; roll</span>
          </figcaption>
        </figure>
      </div>

      <!-- Manifest strip -->
      <dl class="grid grid-cols-2 border-t border-line md:grid-cols-4">
        {[
          { dt: 'In stock', dd: '100,000 yd' },
          { dt: 'Serving composites since', dd: '2001' },
          { dt: 'Typical carbon weight savings', dd: '~30%' },
          { dt: 'Warehouse', dd: 'Reno, NV' },
        ].map((stat, i) => (
          <div class:list={['py-6 pr-6', i > 0 && 'md:border-l md:border-line md:pl-6']}>
            <dt class="eyebrow text-stone-500">{stat.dt}</dt>
            <dd class="type-display mt-1.5 text-2xl text-ink-950">{stat.dd}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Line card: stocked fibers & brands -->
  <div class="border-b border-line bg-white" aria-label="Fibers and brands we stock">
    <div class="frame-x mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-2 px-4 py-3 sm:px-6">
      <span class="eyebrow text-ink-950">Stocking</span>
      <span class="hidden h-3 w-px bg-line sm:block" aria-hidden="true"></span>
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
        {stockedBrands.map((item) => (
          <li class="whitespace-nowrap font-mono text-xs font-medium uppercase tracking-[0.2em] text-stone-600">
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- What we do -->
  <section class="cv-auto border-b border-line">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid items-center gap-14 py-20 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="eyebrow text-stone-500">What we do</p>
          <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">
            Specialists in advanced reinforcements
          </h2>
          <div class="tracer mt-5"></div>
          <p class="mt-6 text-lg leading-8 text-stone-600">
            We are specialists in fiberglass, carbon fiber reinforcements, prepregs, core
            materials, vacuum bagging and infusion materials for aerospace, industrial,
            civil engineering, marine, and many other industries and applications.
          </p>
          <ul class="mt-9 border-t border-line">
            {specialties.map((item) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1 border-b border-line py-3.5">
                <span class="font-display text-[15px] font-semibold text-ink-950">{item.name}</span>
                <span class="eyebrow text-stone-500">{item.tag}</span>
              </li>
            ))}
          </ul>
        </div>
        <figure class="relative">
          <div class="relative border border-line">
            <Image
              src={carbonfiber}
              alt="Close-up of woven carbon fiber fabric"
              widths={[600, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full object-cover"
            />
            <span class="absolute right-0 top-6 h-0.5 w-10 bg-brand" aria-hidden="true"></span>
          </div>
          <figcaption class="eyebrow mt-3 flex justify-between text-stone-500">
            <span>2&times;2 twill weave</span>
            <span>Detail</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="cv-auto border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-20 sm:py-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow text-stone-600">The catalog</p>
            <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">
              In stock, ready to ship
            </h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-stone-600">
              A sample of the carbon fiber reinforcements we keep warehoused in Reno,
              ready to ship.
            </p>
          </div>
          <a href="/all-products/" class="eyebrow underline-draw flex items-center gap-2 pb-1 text-ink-950">
            View all products <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="mt-12 grid gap-px sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Composites West -->
  <section class="cv-auto border-b border-line">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-20 sm:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-stone-500">Why Composites West</p>
          <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">
            Why manufacturers work with us
          </h2>
          <div class="tracer mt-5"></div>
          <p class="mt-6 text-lg leading-8 text-stone-600">
            A small, knowledgeable team that connects materials to customers and builds
            long-term supply relationships.
          </p>
        </div>
        <dl class="mt-14 grid border-t border-line sm:grid-cols-3">
          <div class="flex flex-col border-b border-line py-8 sm:border-b-0 sm:pr-8">
            <dt class="eyebrow order-2 mt-3 text-stone-500">Linear yards in stock</dt>
            <dd class="type-display order-1 text-5xl text-ink-950 lg:text-6xl">100,000</dd>
            <dd class="order-3 mt-2 text-sm leading-6 text-stone-600">
              Warehoused in Reno and ready to ship.
            </dd>
          </div>
          <div class="flex flex-col border-b border-line py-8 sm:border-b-0 sm:border-l sm:px-8">
            <dt class="eyebrow order-2 mt-3 text-stone-500">Years of expertise</dt>
            <dd class="type-display order-1 text-5xl text-ink-950 lg:text-6xl">20+</dd>
            <dd class="order-3 mt-2 text-sm leading-6 text-stone-600">
              Founded in 2001 when sailboat racing and carbon fiber collided.
            </dd>
          </div>
          <div class="flex flex-col py-8 sm:border-l sm:pl-8">
            <dt class="eyebrow order-2 mt-3 text-stone-500">Typical weight savings</dt>
            <dd class="type-display order-1 text-5xl text-ink-950 lg:text-6xl">~30%</dd>
            <dd class="order-3 mt-2 text-sm leading-6 text-stone-600">
              When converting fiberglass or aluminum parts to carbon fiber.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cv-auto border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-12 py-20 sm:py-24 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-stone-600">FAQ</p>
          <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">
            Frequently asked questions
          </h2>
          <div class="tracer mt-5"></div>
        </div>
        <div class="lg:col-span-8">
          <div class="border-t border-line">
            {faq.map((item) => (
              <details class="group border-b border-line">
                <summary class="flex cursor-pointer list-none items-baseline gap-5 py-5 pr-2 [&::-webkit-details-marker]:hidden">
                  <span class="font-mono text-sm text-stone-500 transition-colors group-open:text-brand-deep" aria-hidden="true">
                    <span class="group-open:hidden">+</span><span class="hidden group-open:inline">&minus;</span>
                  </span>
                  <span class="font-display text-base font-semibold text-ink-950">{item.q}</span>
                </summary>
                <p class="pb-6 pl-9 text-base leading-7 text-stone-600">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
