---
import { Image } from 'astro:assets';
import { formatUsd, type Product } from '../data/products';

interface Props {
  product: Product;
  eager?: boolean;
}

const { product, eager = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/products/*.png',
  { eager: true }
);
const image = images[`../assets/products/${product.image}.png`].default;
---

<article
  class="card group flex h-full flex-col"
  data-brand={product.brand}
  data-weave={product.weave}
  data-tow={product.tow ?? ''}
  data-weight={product.weightOz}
  data-width={product.widthIn}
>
  <a href={`/product/${product.slug}/`} class="flex h-full flex-col">
    <div class="relative aspect-[4/3] overflow-hidden border-b border-line bg-paper">
      <Image
        src={image}
        alt={product.name}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover"
        loading={eager ? 'eager' : 'lazy'}
      />
      <span class="eyebrow absolute left-3 top-3 bg-ink-950/85 px-2 py-1 text-white">
        {product.brand}
      </span>
    </div>
    <div class="flex flex-1 flex-col p-5">
      <p class="eyebrow text-stone-500">{product.weaveLabel}</p>
      <h3 class="mt-2 font-display text-base font-semibold leading-snug text-ink-950">
        {product.shortName}
      </h3>
      <p class="mt-3 font-mono text-xs leading-5 text-stone-500">
        {product.weightOz} oz/yd&sup2; ({product.weightGsm} gsm)
        &nbsp;&middot;&nbsp; {product.widthIn}&Prime; wide{product.tow && (
          <Fragment>&nbsp;&middot;&nbsp; {product.tow} tow</Fragment>
        )}
      </p>
      {product.priceUsd && (
        <p class="mt-3 font-mono text-sm text-ink-950">
          {formatUsd(product.priceUsd)} <span class="text-xs text-stone-500">/ roll</span>
        </p>
      )}
      <p class="eyebrow mt-auto flex items-center gap-2 pt-5 text-ink-950">
        View spec
        <span class="inline-block h-px w-6 bg-ink-950"></span>
      </p>
    </div>
  </a>
</article>
