---
import { company } from '../data/products';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = "Let's start something new — or just say hello.",
  text = 'Our expert sales team can match the right materials to any project, often saving you money and time in the process.',
} = Astro.props;
---

<section class="twill cv-auto relative">
  <div class="frame-x frame-dark relative mx-auto max-w-7xl px-4 sm:px-6">
    <span class="crosshair crosshair-dark left-4 top-8 sm:left-6" aria-hidden="true"></span>
    <span class="crosshair crosshair-dark bottom-8 right-4 sm:right-6" aria-hidden="true"></span>
    <div class="flex flex-col items-start gap-8 py-20 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow text-brand">Get in touch</p>
        <h2 class="type-display mt-4 text-3xl text-white sm:text-4xl">{heading}</h2>
        <p class="mt-4 text-lg leading-8 text-stone-400">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary">
          Contact us today <span class="btn-arrow">&rarr;</span>
        </a>
        <a href={`tel:${company.phoneHref}`} class="btn btn-outline-light">
          {company.phone}
        </a>
      </div>
    </div>
  </div>
</section>
