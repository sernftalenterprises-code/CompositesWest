---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | Composites West, Inc."
  description="The page you're looking for could not be found. Browse Composites West's carbon fiber fabrics and composite materials."
>
  <section class="twill relative isolate overflow-hidden">
    <div class="frame-x frame-dark relative mx-auto max-w-7xl px-4 sm:px-6">
      <span class="crosshair crosshair-dark left-4 top-8 sm:left-6" aria-hidden="true"></span>
      <span class="crosshair crosshair-dark right-4 top-8 sm:right-6" aria-hidden="true"></span>
      <span class="crosshair crosshair-dark bottom-8 left-4 sm:left-6" aria-hidden="true"></span>
      <span class="crosshair crosshair-dark bottom-8 right-4 sm:right-6" aria-hidden="true"></span>

      <div class="flex flex-col items-center py-24 text-center sm:py-32">
        <p class="hero-enter eyebrow flex items-center gap-3 text-brand">
          <span class="inline-block h-px w-8 bg-brand" aria-hidden="true"></span>
          Doc not found &mdash; check the register
          <span class="inline-block h-px w-8 bg-brand" aria-hidden="true"></span>
        </p>
        <p class="hero-enter hero-enter-1 type-display mt-6 text-8xl text-white sm:text-[11rem] lg:text-[13rem]">
          404
        </p>
        <h1 class="hero-enter hero-enter-2 type-display mt-4 text-3xl uppercase text-white sm:text-4xl">
          Page not found
        </h1>
        <div class="hero-enter hero-enter-2 tracer mt-6"></div>
        <p class="hero-enter hero-enter-3 mt-6 max-w-xl text-lg leading-8 text-stone-400">
          That page seems to have delaminated. Try one of these instead:
        </p>
        <div class="hero-enter hero-enter-4 mt-9 flex flex-wrap justify-center gap-3">
          <a href="/" class="btn btn-primary">Home <span class="btn-arrow">&rarr;</span></a>
          <a href="/all-products/" class="btn btn-outline-light">Shop fabrics</a>
          <a href="/contact/" class="btn btn-outline-light">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
