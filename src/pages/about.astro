---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import team from '../assets/hero-team.png';
import canoe from '../assets/markets/canoe.jpg';

const markets = [
  {
    name: 'Aerospace',
    text: 'Our carbon fiber products are extremely popular within military aerospace because of their low weight, high temperature resistance, strength, and rigidity. Carbon fiber is also used in civilian aircraft, making up parts of the body, wings, and tail.',
  },
  {
    name: 'Marine',
    text: 'The high specific stiffness of carbon fiber is excellent in applications such as masts, hulls, and propellers. This material change makes yachts, cruisers, and racing vessels lighter and stronger for better speed and fuel efficiency.',
  },
  {
    name: 'Sporting Goods',
    text: 'Racquets, skis, snowboards, bats, and bicycles have all been advanced through carbon fiber reinforcements. Carbon fiber fabric allows for precise shaping of equipment, providing optimal performance.',
  },
  {
    name: 'Infrastructure',
    text: 'The enhanced load-bearing capabilities of carbon fiber materials allow for less strain on infrastructure, with cost benefits from minimally invasive repair methods. Upgrade concrete structures with this less corrosive option for long-term durability.',
  },
  {
    name: 'Automotive',
    text: 'With an excellent strength-to-weight ratio, carbon fiber fabrics are often used to manufacture structural vehicle components — trunks, hoods, trunk spoilers, and front lip spoilers.',
  },
  {
    name: '& More',
    text: 'There is an approximate 30% weight savings generated by converting fiberglass or aluminum parts to carbon fiber. If you have a project that would benefit from this technology, we can help make it happen.',
  },
];

const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Composites West',
  url: 'https://compositeswest.com/about/',
};
---

<Base
  title="About | Composites West, Inc."
  description="Founded in 2001, Composites West is a carbon fiber reinforcement boutique serving aerospace, marine, sporting goods, infrastructure, and automotive markets with a large in-stock inventory ready to ship."
  jsonLd={[aboutLd]}
>
  <!-- Interior page header -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-14 sm:py-20">
        <p class="eyebrow text-stone-500">CW / About — Company</p>
        <h1 class="type-display mt-4 max-w-3xl text-4xl text-ink-950 sm:text-5xl lg:text-6xl">
          Who we are
        </h1>
        <div class="tracer mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
          A reinforcement boutique born from a passion for sailboat racing and carbon fiber.
        </p>
      </div>
    </div>
  </section>

  <!-- 01 / Our story -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid items-center gap-14 py-20 sm:py-24 lg:grid-cols-2">
        <div class="reveal">
          <p class="eyebrow text-stone-500">01 / Our story</p>
          <div class="tracer mt-5"></div>
          <ol class="mt-10 border-l border-line">
            <li class="relative pb-12 pl-8">
              <span class="absolute -left-px top-2 h-0.5 w-5 bg-brand" aria-hidden="true"></span>
              <p class="eyebrow text-stone-500">2001</p>
              <p class="mt-4 text-lg leading-8 text-stone-600">
                Composites West was founded in 2001, when a passion for sailboat racing and
                carbon fiber materials collided. We are a reinforcement boutique that exists
                primarily to supply carbon fiber fabrics and advanced composite materials to
                the many markets that utilize them. We are known for our ability to connect
                and deliver — with a large inventory that we keep in stock and ready to ship.
              </p>
            </li>
            <li class="relative pl-8">
              <span class="absolute -left-px top-2 h-px w-5 bg-line" aria-hidden="true"></span>
              <p class="eyebrow text-stone-500">Today</p>
              <p class="mt-4 text-lg leading-8 text-stone-600">
                At Composites West, you will find a nimble and knowledgeable team who uses
                their wealth of experience to connect materials to customers. We focus on
                long-term partnerships, and we take pride in helping our customers innovate
                and grow their businesses by providing them with cutting-edge composite
                solutions.
              </p>
            </li>
          </ol>
        </div>
        <figure class="reveal reveal-delay-1 relative">
          <div class="relative border border-line">
            <Image
              src={team}
              alt="Unrolled 2×2 twill carbon fiber fabric on a cardboard tube"
              widths={[600, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full object-cover"
            />
            <span class="absolute left-0 top-6 h-0.5 w-10 bg-brand" aria-hidden="true"></span>
          </div>
          <figcaption class="eyebrow mt-3 flex justify-between text-stone-500">
            <span>Fig. 01 — 2&times;2 twill, unrolled</span>
            <span>Est. 2001</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 02 / Markets we serve -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-20 sm:py-24">
        <div class="reveal max-w-2xl">
          <p class="eyebrow text-stone-500">02 / Applications</p>
          <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">Markets we serve</h2>
          <div class="tracer mt-5"></div>
        </div>
        <div class="reveal reveal-delay-1 mt-12 grid gap-px sm:grid-cols-2 lg:grid-cols-3">
          {markets.map((market, i) => (
            <article class="card group p-7">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-lg font-semibold text-ink-950">{market.name}</h3>
                <span class="eyebrow text-stone-400">0{i + 1}</span>
              </div>
              <div class="mt-3 h-0.5 w-8 bg-line transition-all duration-200 group-hover:w-14 group-hover:bg-brand"></div>
              <p class="mt-4 text-sm leading-6 text-stone-600">{market.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Our specialty -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid items-center gap-14 py-20 sm:py-24 lg:grid-cols-2">
        <figure class="reveal relative order-last lg:order-first">
          <div class="relative border border-line">
            <Image
              src={canoe}
              alt="Carbon fiber canoe on the water"
              widths={[600, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full object-cover"
            />
            <span class="absolute right-0 top-6 h-0.5 w-10 bg-brand" aria-hidden="true"></span>
          </div>
          <figcaption class="eyebrow mt-3 flex justify-between text-stone-500">
            <span>Fig. 02 — Carbon fiber canoe</span>
            <span>On the water</span>
          </figcaption>
        </figure>
        <div class="reveal reveal-delay-1">
          <p class="eyebrow text-stone-500">03 / Materials</p>
          <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">Our specialty</h2>
          <div class="tracer mt-5"></div>
          <p class="mt-6 text-lg leading-8 text-stone-600">
            While we stock many composite materials, we are specialists in carbon fiber
            fabric reinforcements. We have a very large inventory of these materials in
            woven, non-crimp (knit), unidirectional, braid, and other constructions.
            Fabrics in stock often include high modulus carbon fiber (HR40), intermediate
            modulus, and 1K, 3K, 6K, and 12K standard modulus materials.
          </p>
          <a href="/all-products/" class="btn btn-primary mt-8">
            Visit our products page <span class="btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Have a question?" text="We are here for you — reach out and we'll connect you to the right materials." />
</Base>
