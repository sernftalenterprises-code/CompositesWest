---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';

/* Sorted lightest first — the table reads as a weight ladder, which is how
   buyers actually narrow the field once construction is settled. */
const rows = [...products].sort((a, b) => a.weightOz - b.weightOz);

/* Construction guidance — the "what does this architecture buy me" layer that
   a spec table alone can't answer. */
const constructions = [
  {
    weave: 'Plain',
    name: 'Plain weave',
    drape: 'Low',
    stability: 'Highest',
    crimp: 'High',
    best: 'Flat sheets, tubes, gentle 2D curves',
    body:
      'The tightest over/under pattern. Short spaces between interlaces make it the most stable fabric for holding weave angle — and the least willing to conform to compound curvature.',
  },
  {
    weave: 'Twill',
    name: '2×2 twill',
    drape: 'Good',
    stability: 'Good',
    crimp: 'Medium',
    best: 'Cosmetic surfaces, complex contours, automotive',
    body:
      'Bridges plain and satin. Fewer crimps and stress concentrations than plain weave, noticeably better drape, and the diagonal pattern most people picture when they hear "carbon fiber."',
  },
  {
    weave: 'Satin',
    name: '8-harness satin',
    drape: 'Excellent',
    stability: 'Moderate',
    crimp: 'Low',
    best: 'Tooling, compound curves, aerospace laminates',
    body:
      'Long float lengths minimize crimp and let the fabric drape over compound curvature that would wrinkle a plain weave. The trade is a less symmetric face and more care needed to keep it on-angle.',
  },
  {
    weave: 'Unidirectional',
    name: 'Unidirectional',
    drape: 'N/A — tape',
    stability: 'Directional',
    crimp: 'None',
    best: 'Spar caps, frames, targeted reinforcement',
    body:
      'Not woven at all. Every fiber runs straight along one axis with zero crimp, which delivers the highest stiffness and strength per gram available — in that direction only.',
  },
  {
    weave: 'Knit',
    name: '±45° non-crimp knit',
    drape: 'Good',
    stability: 'Stitched',
    crimp: 'None',
    best: 'Torsion, shear, marine panels, tubes',
    body:
      'Stitched rather than woven, holding fibers straight on a true ±45° bias. It is what resists twist — and it does so without the crimp penalty a woven bias fabric would carry.',
  },
];

const weightBands = [
  {
    band: 'Light',
    range: '3–6 oz/yd² · 100–205 gsm',
    body:
      'Fine control over laminate thickness and the best conformance on tight curvature. More plies and more labor to reach structural thickness.',
  },
  {
    band: 'Medium',
    range: '8–12 oz/yd² · 300–410 gsm',
    body:
      'The general-purpose band. Enough thickness per ply to build structure at a reasonable pace while still conforming to most geometry.',
  },
  {
    band: 'Heavy',
    range: '19+ oz/yd² · 670+ gsm',
    body:
      'Builds structure fast in few plies — the efficient choice for tooling and thick structural laminates where surface refinement is not the priority.',
  },
];

const faq = [
  {
    q: 'What is areal weight, and why does it matter more than thickness?',
    a: 'Areal weight is the mass of fabric per unit area — expressed in oz/yd² or grams per square meter (gsm). It matters because it directly predicts how much reinforcement a single ply contributes and roughly how thick that ply will be once cured. Two fabrics with the same fiber and different areal weights behave predictably differently, which is why buyers compare on areal weight before almost anything else.',
  },
  {
    q: 'How do I convert between oz/yd² and gsm?',
    a: 'Multiply oz/yd² by roughly 33.9 to get gsm, or divide gsm by 33.9 to get oz/yd². Every fabric on this site lists both, so you do not have to.',
  },
  {
    q: 'What does tow size (3K, 6K, 12K) actually change?',
    a: 'Tow size is the number of filaments in each fiber bundle. Lower counts like 3K weave finer and tighter, giving better surface definition and finer thickness control. Higher counts like 12K build areal weight far faster and cost less per unit of reinforcement, which suits heavy structural laminates and tooling.',
  },
  {
    q: 'More picks means more pliable — what does that mean?',
    a: 'Picks are the crosswise yarns per unit length. More picks means more interlacing points, which lets a fabric articulate and drape more readily over curvature. Fewer picks with longer floats — a satin, for example — behaves differently again: it drapes well because of low crimp rather than frequent interlacing. Either way, weave architecture is what determines whether a fabric conforms or fights you.',
  },
  {
    q: 'Can you supply something not listed here?',
    a: 'Yes — routinely. What we carry is the best of its kind, and sourcing hard-to-find reinforcements, prepregs, honeycomb core, and process materials to spec is a large part of what we do. Send us the requirement.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to select a carbon fiber fabric',
  description:
    'A four-step method for narrowing carbon fiber reinforcements: fiber type, areal weight, construction, and roll width.',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Start with fiber type', text: 'Decide whether standard, intermediate, or high modulus fiber is required. Modulus governs stiffness; strength alone rarely decides it.' },
    { '@type': 'HowToStep', position: 2, name: 'Set the areal weight', text: 'Choose how much reinforcement each ply should contribute, in oz/yd² or gsm. This drives ply count, laminate thickness, and build labor.' },
    { '@type': 'HowToStep', position: 3, name: 'Choose the construction', text: 'Match weave architecture to geometry and load direction — plain, twill, satin, unidirectional, or ±45° knit.' },
    { '@type': 'HowToStep', position: 4, name: 'Check roll width', text: 'Confirm the roll is wide enough to cover the part without unnecessary seams or waste.' },
  ],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://compositeswest.com/' },
    { '@type': 'ListItem', position: 2, name: 'Fabric Selector', item: 'https://compositeswest.com/fabric-selector/' },
  ],
};
---

<Base
  title="Fabric Selection Guide | Compare Carbon Fiber Fabrics | Composites West"
  description="How to choose a carbon fiber fabric: fiber type, areal weight, weave construction, and width — with a side-by-side comparison of every reinforcement we carry at Composites West."
  jsonLd={[howToLd, faqLd, breadcrumbLd]}
>
  <!-- Interior page header -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x relative mx-auto max-w-[1600px] px-5 sm:px-8">
      <span class="crosshair left-5 top-8 sm:left-8" aria-hidden="true"></span>
      <span class="crosshair right-5 top-8 sm:right-8" aria-hidden="true"></span>
      <div class="py-14 sm:py-20">
        <p class="eyebrow text-tow-500">CW / fabric-selector — Guide</p>
        <h1 class="type-display mt-4 max-w-3xl text-4xl text-filament sm:text-5xl lg:text-6xl">
          Which fabric do you need?
        </h1>
        <div class="tracer mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-tow-300">
          Four decisions narrow the field almost completely. Here they are in the order that
          matters, with every fabric we carry side by side at the bottom.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/material-finder/" class="btn btn-dark">
            Run it interactively <span class="btn-arrow">&rarr;</span>
          </a>
          <p class="max-w-xs text-sm leading-6 text-tow-500">
            Prefer to answer four questions and get a ranked answer? Use the Material Finder.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 / The four decisions -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-20 sm:py-24">
        <div class="reveal max-w-2xl">
          <p class="eyebrow text-tow-500">01 / Method</p>
          <h2 class="type-display mt-4 text-3xl text-filament sm:text-4xl">
            Four decisions, in order
          </h2>
          <div class="tracer mt-5"></div>
        </div>

        <ol class="reveal reveal-delay-1 mt-12 border-t border-line">
          {[
            {
              n: 'Fiber type',
              lead: 'The one that changes everything downstream.',
              body:
                'Standard modulus covers most work. Intermediate and high modulus — including HR40 — buy stiffness that extra plies of standard modulus cannot match efficiently. If your part is deflection-limited rather than strength-limited, this is where the answer lives.',
            },
            {
              n: 'Areal weight',
              lead: 'How much reinforcement each ply contributes.',
              body:
                'Given in oz/yd² and gsm. Lighter fabric means finer thickness control and better conformance; heavier fabric means fewer plies and less labor to reach structural thickness. This is the second question every technical buyer asks, and often the one that settles it.',
            },
            {
              n: 'Construction',
              lead: 'Whether the fabric will do what the geometry demands.',
              body:
                'Weave architecture decides drape, stability, and crimp. A fabric that bridges or wrinkles on your tool is not a candidate no matter how good its mechanical data looks — and a bias load needs bias fiber, not a rotated orthogonal weave.',
            },
            {
              n: 'Width',
              lead: 'The practical one people forget until it costs them.',
              body:
                'Roll width determines whether a part is covered in one piece or joined. On large panels the difference between a 50-inch and a 60-inch roll can be an entire seam — which is waste, labor, and on cosmetic parts, a visible defect.',
            },
          ].map((step, i) => (
            <li class="grid gap-x-8 gap-y-3 border-b border-line py-8 lg:grid-cols-12">
              <div class="flex items-baseline gap-4 lg:col-span-4">
                <span class="type-display text-2xl text-brand-deep" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-lg font-semibold text-filament">{step.n}</h3>
                  <p class="mt-1 text-sm leading-6 text-tow-500">{step.lead}</p>
                </div>
              </div>
              <p class="leading-7 text-tow-300 lg:col-span-8">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 02 / Construction comparison -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-20 sm:py-24">
        <div class="reveal max-w-2xl">
          <p class="eyebrow text-tow-500">02 / Construction</p>
          <h2 class="type-display mt-4 text-3xl text-filament sm:text-4xl">
            How the constructions compare
          </h2>
          <div class="tracer mt-5"></div>
          <p class="mt-6 text-lg leading-8 text-tow-300">
            Drape and stability trade against each other. Pick the point on that trade your
            geometry actually needs.
          </p>
        </div>

        <div class="reveal reveal-delay-1 table-wrap mt-10">
          <table class="table-spec">
            <thead>
              <tr>
                <th scope="col">Construction</th>
                <th scope="col">Drape</th>
                <th scope="col">Stability</th>
                <th scope="col">Crimp</th>
                <th scope="col">Best for</th>
                <th scope="col"><span class="sr-only">Browse</span></th>
              </tr>
            </thead>
            <tbody>
              {constructions.map((c) => (
                <tr>
                  <th scope="row" class="row-head">{c.name}</th>
                  <td class="font-mono text-filament">{c.drape}</td>
                  <td class="font-mono text-filament">{c.stability}</td>
                  <td class="font-mono text-filament">{c.crimp}</td>
                  <td>{c.best}</td>
                  <td>
                    <a
                      href={`/all-products/?weave=${encodeURIComponent(c.weave)}`}
                      class="eyebrow underline-draw whitespace-nowrap text-filament"
                    >
                      View &rarr;
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-12 grid gap-px sm:grid-cols-2 lg:grid-cols-3">
          {constructions.map((c) => (
            <article class="card group p-7">
              <h3 class="font-display text-lg font-semibold text-filament">{c.name}</h3>
              <div
                class="mt-3 h-0.5 w-8 bg-line transition-all duration-200 group-hover:w-14 group-hover:bg-brand"
              >
              </div>
              <p class="mt-4 text-sm leading-6 text-tow-300">{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Weight bands -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-20 sm:py-24">
        <div class="reveal max-w-2xl">
          <p class="eyebrow text-tow-500">03 / Areal weight</p>
          <h2 class="type-display mt-4 text-3xl text-filament sm:text-4xl">
            Reading the weight bands
          </h2>
          <div class="tracer mt-5"></div>
        </div>
        <dl class="reveal reveal-delay-1 mt-12 grid border-t border-line sm:grid-cols-3">
          {weightBands.map((b, i) => (
            <div
              class:list={[
                'flex flex-col border-b border-line py-8 sm:border-b-0',
                i === 0 ? 'sm:pr-8' : 'sm:border-l sm:px-8',
                i === 2 && 'sm:pr-0',
              ]}
            >
              <dt class="eyebrow order-2 mt-3 text-tow-500">{b.range}</dt>
              <dd class="type-display order-1 text-4xl text-filament lg:text-5xl">{b.band}</dd>
              <dd class="order-3 mt-3 text-sm leading-6 text-tow-300">{b.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 04 / Compare every fabric -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-20 sm:py-24">
        <div class="reveal flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl">
            <p class="eyebrow text-tow-500">04 / Comparison</p>
            <h2 class="type-display mt-4 text-3xl text-filament sm:text-4xl">
              Every fabric we carry, side by side
            </h2>
            <div class="tracer mt-5"></div>
            <p class="mt-6 text-lg leading-8 text-tow-300">
              Sorted lightest to heaviest. Sort by any column to compare on what matters to
              you.
            </p>
          </div>
          <a href="/all-products/" class="eyebrow underline-draw flex items-center gap-2 pb-1 text-filament">
            Browse with filters <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="reveal reveal-delay-1 table-wrap mt-10">
          <table class="table-spec" id="compare">
            <thead>
              <tr>
                <th scope="col"><button type="button" data-sort="name" class="sort-btn">Fabric</button></th>
                <th scope="col"><button type="button" data-sort="brand" class="sort-btn">Brand</button></th>
                <th scope="col"><button type="button" data-sort="weave" class="sort-btn">Construction</button></th>
                <th scope="col"><button type="button" data-sort="tow" class="sort-btn">Tow</button></th>
                <th scope="col"><button type="button" data-sort="weight" class="sort-btn" data-numeric>oz/yd²</button></th>
                <th scope="col"><button type="button" data-sort="gsm" class="sort-btn" data-numeric>gsm</button></th>
                <th scope="col"><button type="button" data-sort="width" class="sort-btn" data-numeric>Width</button></th>
              </tr>
            </thead>
            <tbody>
              {rows.map((p) => (
                <tr
                  data-name={p.shortName}
                  data-brand={p.brand}
                  data-weave={p.weaveLabel}
                  data-tow={p.tow ?? ''}
                  data-weight={p.weightOz}
                  data-gsm={p.weightGsm}
                  data-width={p.widthIn}
                >
                  <th scope="row" class="row-head">
                    <a href={`/product/${p.slug}/`} class="underline-draw">{p.shortName}</a>
                  </th>
                  <td>{p.brand}</td>
                  <td>{p.weaveLabel}</td>
                  <td class="font-mono text-filament">{p.tow ?? '—'}</td>
                  <td class="font-mono text-filament">{p.weightOz}</td>
                  <td class="font-mono text-filament">{p.weightGsm}</td>
                  <td class="font-mono text-filament">{p.widthIn}&Prime;</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 max-w-3xl text-sm leading-6 text-tow-300">
          Roll lengths and other widths vary — several of these are available in formats not
          listed here, and we source well beyond what is listed.{' '}
          <a href="/contact/" class="underline-draw font-semibold text-filament">Tell us what you need.</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 05 / FAQ -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="grid gap-12 py-20 sm:py-24 lg:grid-cols-12">
        <div class="reveal lg:col-span-4">
          <p class="eyebrow text-tow-500">05 / FAQ</p>
          <h2 class="type-display mt-4 text-3xl text-filament sm:text-4xl">
            Reading a spec sheet
          </h2>
          <div class="tracer mt-5"></div>
        </div>
        <div class="reveal reveal-delay-1 lg:col-span-8">
          <div class="border-t border-line">
            {faq.map((item) => (
              <details class="group border-b border-line">
                <summary
                  class="flex cursor-pointer list-none items-baseline gap-5 py-5 pr-2 [&::-webkit-details-marker]:hidden"
                >
                  <span
                    class="font-mono text-sm text-tow-500 transition-colors group-open:text-brand-deep"
                    aria-hidden="true"
                  >
                    <span class="group-open:hidden">+</span><span class="hidden group-open:inline">&minus;</span>
                  </span>
                  <span class="font-display text-base font-semibold text-filament">{item.q}</span>
                </summary>
                <p class="pb-6 pl-9 text-base leading-7 text-tow-300">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Still deciding?"
    text="Send us the part, the loads, and the process. We've been matching materials to applications since 2001 — and we'd rather get it right than sell you a roll you don't need."
  />
</Base>

<style>
  .table-spec tbody th.row-head {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-filament);
    white-space: normal;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }
  .table-spec tbody tr:last-child th.row-head {
    border-bottom: 0;
  }

  /* Sortable column headers keep the mono label look but read as buttons. */
  .sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s ease-out;
  }
  .sort-btn:hover {
    color: var(--color-filament);
  }
  .sort-btn::after {
    content: "↕";
    font-size: 0.85em;
    opacity: 0.4;
  }
  .sort-btn[data-dir="asc"]::after {
    content: "↑";
    opacity: 1;
    color: var(--color-brand-deep);
  }
  .sort-btn[data-dir="desc"]::after {
    content: "↓";
    opacity: 1;
    color: var(--color-brand-deep);
  }
</style>

<script>
  import { boot } from '../scripts/boot';
  boot('fabricSelector', '#compare', () => {
  const table = document.getElementById('compare') as HTMLTableElement | null;
  if (table) {
    const tbody = table.tBodies[0];
    const buttons = [...table.querySelectorAll<HTMLButtonElement>('.sort-btn')];

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort!;
        const numeric = 'numeric' in btn.dataset;
        const dir = btn.dataset.dir === 'asc' ? 'desc' : 'asc';

        for (const other of buttons) delete other.dataset.dir;
        btn.dataset.dir = dir;

        const rows = [...tbody.rows];
        rows.sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          const cmp = numeric
            ? Number(av) - Number(bv)
            : av.localeCompare(bv, 'en', { numeric: true });
          return dir === 'asc' ? cmp : -cmp;
        });
        for (const row of rows) tbody.appendChild(row);
      });
    }
  }
  });
</script>
