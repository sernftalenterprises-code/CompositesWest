---
import Base from '../layouts/Base.astro';
import { company } from '../data/products';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Composites West',
  url: 'https://compositeswest.com/contact/',
};
---

<Base
  title="Contact | Composites West, Inc."
  description="Contact Composites West in Reno, NV for carbon fiber fabrics and advanced composite materials. Call (775) 833-4300 or email info@compositeswest.com for quotes and sourcing."
  jsonLd={[contactLd]}
>
  <!-- Interior page header -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-14 sm:py-20">
        <p class="eyebrow text-tow-500">CW / contact — Inquiries</p>
        <h1 class="type-display mt-4 max-w-3xl text-4xl text-filament sm:text-5xl lg:text-6xl">
          Let's connect.
        </h1>
        <div class="tracer mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-tow-300">
          Start something new — or just say hello. We are here for you, and we mean it.
        </p>
      </div>
    </div>
  </section>

  <!-- 01 / Send a message + 02 / Direct lines -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="grid gap-14 py-20 sm:py-24 lg:grid-cols-12 lg:gap-8">
        <div class="reveal lg:col-span-7">
          <p class="eyebrow text-tow-500">01 / Send a message</p>
          <form
            id="contact-form"
            method="POST"
            action="#"
            class="mt-8 space-y-7"
            novalidate
          >
            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="name" class="eyebrow block text-tow-500">Name</label>
                <input
                  type="text" id="name" name="name" required autocomplete="name"
                  class="mt-2.5 w-full border border-line bg-carbon-900 px-4 py-3 text-filament transition-colors duration-150 ease-out focus:border-brand"
                />
              </div>
              <div>
                <label for="email" class="eyebrow block text-tow-500">Email address</label>
                <input
                  type="email" id="email" name="email" required autocomplete="email"
                  class="mt-2.5 w-full border border-line bg-carbon-900 px-4 py-3 text-filament transition-colors duration-150 ease-out focus:border-brand"
                />
              </div>
            </div>
            <div>
              <label for="phone" class="eyebrow block text-tow-500">Phone number</label>
              <input
                type="tel" id="phone" name="phone" autocomplete="tel"
                class="mt-2.5 w-full border border-line bg-carbon-900 px-4 py-3 text-filament transition-colors duration-150 ease-out focus:border-brand"
              />
            </div>
            <div>
              <label for="message" class="eyebrow block text-tow-500">Message</label>
              <textarea
                id="message" name="message" rows="6" required
                class="mt-2.5 w-full border border-line bg-carbon-900 px-4 py-3 text-filament transition-colors duration-150 ease-out focus:border-brand"
              ></textarea>
            </div>
            <button type="submit" class="btn btn-primary">
              Send <span class="btn-arrow">&rarr;</span>
            </button>
            <p class="text-sm leading-6 text-tow-300">
              Prefer email? Write to <a href={`mailto:${company.email}`} class="underline-draw font-medium text-filament">{company.email}</a>
            </p>
          </form>
        </div>

        <aside class="reveal reveal-delay-1 lg:col-span-4 lg:col-start-9">
          <p class="eyebrow text-tow-500">02 / Direct lines</p>
          <div class="mt-8 border-t border-line">
            <div class="border-b border-line py-7">
              <h2 class="eyebrow text-filament">Contact us</h2>
              <ul class="mt-4 space-y-1.5 font-mono text-[13px] leading-6 text-tow-300">
                <li>Office: <a href={`tel:${company.phoneHref}`} class="underline-draw text-filament">{company.phone}</a></li>
                <li>Fax: {company.fax}</li>
                <li>Email: <a href={`mailto:${company.email}`} class="underline-draw text-filament">{company.email}</a></li>
              </ul>
            </div>
            <div class="border-b border-line py-7">
              <h2 class="eyebrow text-filament">Physical address</h2>
              <address class="mt-4 font-mono text-[13px] not-italic leading-6 text-tow-300">
                {company.physicalAddress.street}<br />
                {company.physicalAddress.city}, {company.physicalAddress.state} {company.physicalAddress.zip}
              </address>
            </div>
            <div class="border-b border-line py-7">
              <h2 class="eyebrow text-filament">Mailing address</h2>
              <address class="mt-4 font-mono text-[13px] not-italic leading-6 text-tow-300">
                {company.mailingAddress.street}<br />
                {company.mailingAddress.city}, {company.mailingAddress.state} {company.mailingAddress.zip}
              </address>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { boot } from '../scripts/boot';
  boot('contact', '#contact-form', () => {
  // Prefill the message when arriving from a product page (?product=...)
  const params = new URLSearchParams(location.search);
  const productName = params.get('product');
  const message = document.getElementById('message') as HTMLTextAreaElement | null;
  if (productName && message && !message.value) {
    message.value = `Hi, I'd like a quote for: ${productName}\n\nQuantity / length needed: \nDeliver to (city, state): `;
  }

  // TODO for launch: point this form at your form handler (Formspree, Netlify
  // Forms, or a WP endpoint). Until then it falls back to a prefilled email.
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const subject = productName ? `Quote request: ${productName}` : 'Website inquiry';
    const body = [
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      `Phone: ${data.get('phone') || '—'}`,
      '',
      String(data.get('message') ?? ''),
    ].join('\n');
    location.href = `mailto:info@compositeswest.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
  });
</script>
