---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { applications } from '../../data/applications';

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/{*,markets/*}.{png,jpg,jpeg}',
  { eager: true }
);
const imageFor = (name: string) =>
  Object.entries(photos).find(
    ([path]) => path.replace(/^.*\//, '').replace(/\.(png|jpg|jpeg)$/, '') === name
  )![1].default;

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Carbon fiber applications and markets',
  itemListElement: applications.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://compositeswest.com/applications/${a.slug}/`,
    name: a.name,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://compositeswest.com/' },
    { '@type': 'ListItem', position: 2, name: 'Applications', item: 'https://compositeswest.com/applications/' },
  ],
};
---

<Base
  title="Applications | Carbon Fiber by Market | Composites West"
  description="How carbon fiber is selected and used across aerospace, marine, infrastructure and seismic retrofit, sporting goods, and automotive — what drives the material decision in each, and which reinforcements fit."
  jsonLd={[itemListLd, breadcrumbLd]}
>
  <!-- Interior page header -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x relative mx-auto max-w-7xl px-4 sm:px-6">
      <span class="crosshair left-4 top-8 sm:left-6" aria-hidden="true"></span>
      <span class="crosshair right-4 top-8 sm:right-6" aria-hidden="true"></span>
      <div class="py-14 sm:py-20">
        <p class="eyebrow text-stone-500">CW / applications — By market</p>
        <h1 class="type-display mt-4 max-w-3xl text-4xl text-ink-950 sm:text-5xl lg:text-6xl">
          Start with the application
        </h1>
        <div class="tracer mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
          Fiber type and areal weight decide most of it — but what those numbers should be
          depends entirely on what you're building. Here's how the decision goes in each
          market we serve.
        </p>
      </div>
    </div>
  </section>

  <!-- 01 / Markets -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-16 sm:py-20">
        <div class="reveal flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink-950 pb-4">
          <p class="eyebrow text-stone-500">01 / Markets</p>
          <p class="eyebrow text-ink-950">{String(applications.length).padStart(2, '0')} applications</p>
        </div>

        <div class="mt-10 grid gap-px sm:grid-cols-2 lg:grid-cols-3">
          {applications.map((application, i) => (
            <article class:list={['card group flex h-full flex-col', 'reveal', i > 0 && `reveal-delay-${Math.min(i, 3)}`]}>
              <a href={`/applications/${application.slug}/`} class="flex h-full flex-col">
                <div class="relative aspect-[4/3] overflow-hidden border-b border-line bg-paper">
                  <Image
                    src={imageFor(application.photo)}
                    alt={application.photoCaption}
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                  <span class="eyebrow absolute left-3 top-3 bg-ink-950/85 px-2 py-1 text-white">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h2 class="font-display text-lg font-semibold leading-snug text-ink-950">
                    {application.shortName}
                  </h2>
                  <p class="mt-3 text-sm leading-6 text-stone-600">{application.tagline}</p>
                  <p class="eyebrow mt-auto flex items-center gap-2 pt-6 text-ink-950">
                    Read the guide
                    <span class="inline-block h-px w-6 bg-ink-950 transition-all duration-200 group-hover:w-10 group-hover:bg-brand"></span>
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Not listed -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal py-16 sm:py-20">
        <p class="eyebrow text-stone-500">02 / Everything else</p>
        <h2 class="type-display mt-4 max-w-2xl text-3xl text-ink-950 sm:text-4xl">
          Your application isn't on this list
        </h2>
        <div class="tracer mt-5"></div>
        <div class="mt-6 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
          <p class="max-w-2xl text-lg leading-8 text-stone-600">
            Industrial equipment, medical and orthotic devices, energy, robotics, tooling,
            prototyping — carbon reinforcements turn up anywhere strength-to-weight is worth
            paying for. Converting a fiberglass or aluminum part typically saves around 30%
            of its weight. Tell us what you're building.
          </p>
          <a href="/contact/" class="btn btn-dark shrink-0">
            Talk it through <span class="btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
