---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const beforeSteps = [
  'Drill hole in the prepared concrete as per dimensions on drawings. Prepared concrete is defined as sand-blasted clean, with holes/depressions filled and protrusions ground down.',
  'Apply epoxy prime coats as per Hex-3R Wrap instructions. Note: the installation of the Hex-3R FibrAnchors and Hex-3R Wrap must be applied as a system (before the epoxy is fully cured) in order to form a laminate.',
  'Fold the Hex-3R FibrAnchor in half and insert into the resin-filled hole using a rod or probe, ensuring it reaches the bottom of the hole — or fold the FibrAnchor in half on the tip of an epoxy tube applicator and insert into the hole, ejecting the resin so the FibrAnchor is pushed into place.',
  'Bend the protruding ends of the Hex-3R FibrAnchor over, spread the fibers over the surface, and embed them in the resin film on the surface of the saturated fabric layer.',
  'Install a saturated layer of Hex-3R Wrap as per plans over the Hex-3R FibrAnchors. Smooth down the surface of the fabric to remove any entrapped air and apply even pressure in an outward motion where the anchors are installed. The "fan" of anchor threads must be completely laminated to the Hex-3R Wrap.',
  'Apply successive layers of Hex-3R Wrap as per plans.',
];

const throughSteps = [
  'Drill hole in the prepared concrete as per dimensions on drawings. Prepared concrete is defined as sand-blasted clean, with holes/depressions filled and protrusions ground down.',
  'Apply epoxy prime coats as per Hex-3R Wrap instructions. Note: the installation of the Hex-3R FibrAnchors and Hex-3R Wrap must be applied as a system (before the epoxy is fully cured) in order to form a laminate.',
  'Insert a short dowel (about 70 mm (3″), under 10 mm (3/8″) in diameter) to mark hole locations. Apply initial saturated Hex-3R Wrap layers, carefully parting the fibers around the dowel and pressing the fiber tows smooth to the wall surface. Remove the dowel and fill the hole with resin immediately prior to installing the FibrAnchors.',
  'Fold the Hex-3R FibrAnchor in half and insert into the resin-filled hole using a rod or probe, ensuring it reaches the bottom of the hole — or fold the FibrAnchor in half on the tip of an epoxy tube applicator and insert into the hole, ejecting the resin so the FibrAnchor is pushed into place.',
  'Bend the protruding ends of the Hex-3R FibrAnchor over, spread the fibers over the surface, and embed them in the resin film on the surface of the saturated fabric layer.',
  'Place the final saturated layer of fabric (face layer) over the previous layer and FibrAnchors. Smooth down the surface to remove entrapped air and apply even pressure in an outward motion where the anchors are installed. The "fan" of anchor threads must be completely laminated to the Hex-3R Wrap.',
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://compositeswest.com/' },
    { '@type': 'ListItem', position: 2, name: 'Hex-3R Products', item: 'https://compositeswest.com/hex-3r-products/' },
    { '@type': 'ListItem', position: 3, name: 'FibrAnchor Installation', item: 'https://compositeswest.com/fibranchor-installation-instructions/' },
  ],
};
---

<Base
  title="Hex-3R FibrAnchor Installation Instructions | Composites West"
  description="How to install Hex-3R FibrAnchors before or through the Hex-3R Wrap to significantly increase shear strength in FRP concrete strengthening systems."
  jsonLd={[breadcrumbLd]}
>
  <!-- Page header -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-14 sm:py-20">
        <p class="eyebrow text-stone-500">CW / Hex-3R-FibrAnchor &mdash; Procedures</p>
        <h1 class="type-display mt-4 max-w-3xl text-4xl text-ink-950 sm:text-5xl lg:text-6xl">
          FibrAnchor installation instructions
        </h1>
        <div class="tracer mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
          Tests indicate that the use of Hex-3R FibrAnchors significantly increases shear
          strength. FibrAnchors can be applied before or after the Hex-3R Wrap.
        </p>
      </div>
    </div>
  </section>

  <!-- 01 / Application before Hex-3R Wrap -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <article class="max-w-4xl py-16 sm:py-20">
        <div class="reveal">
          <p class="eyebrow text-stone-500">01 / Before the wrap</p>
          <h2 class="type-display mt-4 text-2xl text-ink-950 sm:text-3xl">Application before Hex-3R Wrap</h2>
          <p class="mt-5 max-w-2xl leading-7 text-stone-600">
            To ensure proper anchorage, apply even pressure in an outward motion on the
            surface of the Hex-3R Wrap where the anchors are installed. The "fan" of anchor
            threads must be completely laminated to the Hex-3R Wrap.
          </p>
        </div>
        <ol class="reveal reveal-delay-1 mt-10 border-t border-line">
          {beforeSteps.map((step, i) => (
            <li class="border-b border-line py-6 sm:py-7 md:grid md:grid-cols-12 md:gap-8">
              <div class="mb-3 md:col-span-2 md:mb-0">
                <span class="font-mono text-2xl font-medium leading-none text-ink-950 sm:text-3xl">0{i + 1}</span>
              </div>
              <p class="leading-7 text-stone-600 md:col-span-10">{step}</p>
            </li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  <!-- 02 / Application through Hex-3R Wrap -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-7xl px-4 sm:px-6">
      <article class="max-w-4xl py-16 sm:py-20">
        <div class="reveal">
          <p class="eyebrow text-stone-500">02 / Through the wrap</p>
          <h2 class="type-display mt-4 text-2xl text-ink-950 sm:text-3xl">Application through Hex-3R Wrap</h2>
          <p class="mt-5 max-w-2xl leading-7 text-stone-600">
            Hex-3R FibrAnchors installed through the laminate ensure proper contact between
            the anchor "fan" and the Hex-3R Wrap. This type of installation pins the wrap
            against the concrete surface, and the FibrAnchors may be installed after the
            wrap has cured.
          </p>
          <div class="mt-6 border border-line border-l-2 border-l-brand bg-white p-5 sm:p-6">
            <p class="eyebrow text-stone-500">Note</p>
            <p class="mt-3 font-display text-sm font-semibold text-ink-950">Two drawbacks of this method:</p>
            <ul class="mt-2 list-[square] space-y-1 pl-5 text-sm leading-6 text-stone-600 marker:text-stone-400">
              <li>The Hex-3R Wrap system is locally damaged at the holes.</li>
              <li>The surface of the wrap around the hole must be roughened to ensure a proper laminate bond between the anchor "fan" and the wrap — use medium-grit sandpaper, being careful not to damage the fabric fibers.</li>
            </ul>
          </div>
        </div>
        <ol class="reveal reveal-delay-1 mt-10 border-t border-line">
          {throughSteps.map((step, i) => (
            <li class="border-b border-line py-6 sm:py-7 md:grid md:grid-cols-12 md:gap-8">
              <div class="mb-3 md:col-span-2 md:mb-0">
                <span class="font-mono text-2xl font-medium leading-none text-ink-950 sm:text-3xl">0{i + 1}</span>
              </div>
              <p class="leading-7 text-stone-600 md:col-span-10">{step}</p>
            </li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  <CtaBand heading="Questions about FibrAnchors?" text="We can advise on anchor layout, hole sizing, and system compatibility for your project." />
</Base>
