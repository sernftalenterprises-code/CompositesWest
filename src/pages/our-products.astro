---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import rolls from '../assets/rolls.jpg';
import carbonfiber from '../assets/carbonfiber.jpeg';
import knits from '../assets/knits.png';
import raw from '../assets/raw.jpg';

const categories = [
  {
    name: 'Plain Weave Reinforcements',
    image: carbonfiber,
    text: 'Woven in an over/under pattern, the short space between interlaces gives this material a high level of stability for maintaining weave angle. As the tightest weave pattern, plain weave is best suited for flat sheets, tubes, and 2D curves.',
    href: '/all-products/?weave=Plain',
  },
  {
    name: 'Twill Weave Reinforcements',
    image: rolls,
    text: 'Bridging plain and satin weaves, twill offers great pliability while forming complex contours. With fewer crimps and stress concentrations, it is often used in the automotive industry — and it is the classic cosmetic carbon look.',
    href: '/all-products/?weave=Twill',
  },
  {
    name: 'Unidirectional Reinforcements',
    image: raw,
    text: 'Unwoven to prevent the weakness of crimping, the continuous fibers of this material provide unmatched strength and stiffness along the fiber direction. Commonly used for bicycle frames, spar caps, and targeted reinforcement.',
    href: '/all-products/?weave=Unidirectional',
  },
  {
    name: '±45° Knit (Non-Crimp) Fabrics',
    image: knits,
    text: 'Stitched non-crimp fabrics place fibers on a true ±45° bias for maximum torsional and shear stiffness with zero weave crimp — available in weights from 103 to 408 gsm.',
    href: '/all-products/?weave=Knit',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://compositeswest.com/' },
    { '@type': 'ListItem', position: 2, name: 'Our Products', item: 'https://compositeswest.com/our-products/' },
  ],
};
---

<Base
  title="Our Products | Carbon Fiber Reinforcements | Composites West"
  description="Plain weave, twill weave, unidirectional, and ±45° knit carbon fiber reinforcements — plus prepregs, honeycomb, glass fabrics, and process materials sourced to spec."
  jsonLd={[breadcrumbLd]}
>
  <!-- Interior page header -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-14 sm:py-20">
        <p class="eyebrow text-tow-500">CW / our-products — Materials</p>
        <h1 class="type-display mt-4 max-w-3xl text-4xl text-filament sm:text-5xl lg:text-6xl">
          The right materials can solve many problems
        </h1>
        <div class="tracer mt-6"></div>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-tow-300">
          Our expert sales team can help match the right materials to any project. We can
          often save you money and time by using our product knowledge to help you make
          the right choice in materials.
        </p>
      </div>
    </div>
  </section>

  <!-- 01 / Reinforcement categories -->
  <section class="border-b border-line">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-20 sm:py-24">
        <div class="reveal flex items-center gap-4">
          <p class="eyebrow text-tow-500">01 / Reinforcement categories</p>
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
          <span class="eyebrow text-tow-500">04 categories</span>
        </div>

        <div class="mt-10 grid gap-px md:grid-cols-2">
          {categories.map((cat, i) => (
            <article class={`card group reveal ${i % 2 === 1 ? 'reveal-delay-1' : ''}`}>
              <a href={cat.href} class="flex h-full flex-col">
                <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-paper">
                  <Image
                    src={cat.image}
                    alt={cat.name}
                    widths={[600, 1200]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                  />
                  <span class="eyebrow absolute left-3 top-3 bg-ink-950/85 px-2 py-1 text-white">
                    0{i + 1}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-8">
                  <h2 class="font-display text-xl font-bold leading-snug text-filament">{cat.name}</h2>
                  <p class="mt-3 leading-7 text-tow-300">{cat.text}</p>
                  <p class="eyebrow mt-auto flex items-center gap-2 pt-6 text-filament">
                    Browse the fabrics <span aria-hidden="true">&rarr;</span>
                    <span class="inline-block h-px w-6 self-center bg-line transition-all duration-200 group-hover:w-10 group-hover:bg-brand" aria-hidden="true"></span>
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Sourced to spec -->
  <section class="border-b border-line bg-paper">
    <div class="frame-x mx-auto max-w-[1600px] px-5 sm:px-8">
      <div class="py-20 sm:py-24">
        <div class="reveal relative border border-line bg-carbon-900">
          <span class="crosshair -left-1.5 -top-1.5" aria-hidden="true"></span>
          <span class="crosshair -bottom-1.5 -right-1.5" aria-hidden="true"></span>
          <div class="grid gap-10 p-8 sm:p-10 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-4">
              <p class="eyebrow text-tow-500">02 / Sourced to spec</p>
              <h2 class="type-display mt-4 text-2xl text-filament sm:text-3xl">
                Other advanced composite materials
              </h2>
              <div class="tracer mt-5"></div>
            </div>
            <div class="lg:col-span-8">
              <p class="text-lg leading-8 text-tow-300">
                We also supply prepreg, honeycomb, glass fabrics, and process materials. Have
                specs for your <em>spec</em>ific needs? Our relationships across the industry
                let us source hard-to-find materials to your exact requirements — <a
                  href="/contact/"
                  class="font-semibold text-filament underline decoration-brand decoration-2 underline-offset-[3px] transition-colors hover:text-filament"
                >reach out</a> and we'll track it down.
              </p>
              <div class="mt-7 flex flex-wrap gap-2">
                <span class="chip">Prepreg</span>
                <span class="chip">Honeycomb</span>
                <span class="chip">Glass fabrics</span>
                <span class="chip">Process materials</span>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal reveal-delay-1 mt-14 flex justify-center">
          <a href="/all-products/" class="btn btn-primary">
            See all fabrics <span class="btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
