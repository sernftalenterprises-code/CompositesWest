---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import { company } from '../data/products';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks to inject (already-built objects). */
  jsonLd?: object[];
  ogImage?: string;
  ogType?: string;
}

const { title, description, jsonLd = [], ogImage, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage ?? '/og-default.png', Astro.site);

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://compositeswest.com/#organization',
  name: company.name,
  url: 'https://compositeswest.com/',
  logo: new URL('/logo.png', Astro.site).toString(),
  foundingDate: company.founded,
  description:
    'Composites West is a carbon fiber and advanced composites reinforcement supplier serving aerospace, marine, automotive, sporting goods, and infrastructure markets.',
  email: company.email,
  telephone: company.phoneHref,
  faxNumber: company.fax,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.physicalAddress.street,
    addressLocality: company.physicalAddress.city,
    addressRegion: company.physicalAddress.state,
    postalCode: company.physicalAddress.zip,
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: company.phoneHref,
    contactType: 'sales',
    email: company.email,
    areaServed: 'US',
  },
};

const allJsonLd = [organizationLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fonts />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {allJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="min-h-screen bg-carbon-950 font-sans text-tow-300 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-brand focus:px-4 focus:py-2 focus:text-carbon-950"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="pt-[66px]">
      <slot />
    </main>
    <Footer />

    <!-- Atmosphere: grain + scanline so black is never flat -->
    <div class="atmos" aria-hidden="true"></div>
    <!-- The tracer line that rides the page-transition wipe -->
    <div id="wipe" class="wipe" aria-hidden="true"></div>
    <Cursor />

    <script>
      import { boot, reduceMotion } from '../scripts/boot';

      /* Page-transition wipe: fire the tracer line as the new page clips in */
      document.addEventListener('astro:before-swap', () => {
        const wipe = document.getElementById('wipe');
        if (!wipe || reduceMotion()) return;
        wipe.classList.remove('is-on');
        void wipe.offsetWidth;
        wipe.classList.add('is-on');
      });

      boot('base', () => {
        const reduce = reduceMotion();
        const io = 'IntersectionObserver' in window;

        /* Scroll reveals */
        const revealed = document.querySelectorAll('.reveal');
        if (revealed.length && io) {
          const rio = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); rio.unobserve(e.target); }
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
          revealed.forEach((el) => rio.observe(el));
        } else revealed.forEach((el) => el.classList.add('is-visible'));

        /* Weave tiles build themselves tow-by-tow when they arrive */
        const tiles = document.querySelectorAll('[data-build]');
        if (tiles.length && io && !reduce) {
          const bio = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-built'); bio.unobserve(e.target); }
          }, { threshold: 0.35 });
          tiles.forEach((el) => bio.observe(el));
        } else tiles.forEach((el) => el.classList.add('is-built'));

        /* Count-up for [data-counter] numerals */
        const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
        if (counters.length && io && !reduce) {
          const run = (el: HTMLElement) => {
            const target = Number(el.dataset.target ?? '0');
            const prefix = el.dataset.prefix ?? '';
            const suffix = el.dataset.suffix ?? '';
            const useSep = 'sep' in el.dataset;
            const dur = 1100;
            const t0 = performance.now();
            const tick = (t: number) => {
              const p = Math.min((t - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              const val = Math.round(target * eased);
              el.textContent = prefix + (useSep ? val.toLocaleString('en-US') : String(val)) + suffix;
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          };
          const cio = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { run(e.target as HTMLElement); cio.unobserve(e.target); }
          }, { threshold: 0.5 });
          counters.forEach((el) => cio.observe(el));
        }

        /* Mono HUD labels decode in once, when they come into view */
        const CH = '0123456789ABCDEFX/·—';
        const decode = (el: HTMLElement) => {
          const final = el.textContent ?? '';
          const n = final.length;
          if (!n) return;
          const t0 = performance.now();
          const dur = 480 + n * 12;
          const step = (now: number) => {
            const p = Math.min((now - t0) / dur, 1);
            const k = Math.floor(p * n);
            let out = '';
            for (let i = 0; i < n; i++) {
              const c = final[i];
              out += i < k || c === ' ' ? c : CH[(Math.random() * CH.length) | 0];
            }
            el.textContent = p < 1 ? out : final;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const labels = document.querySelectorAll<HTMLElement>('[data-decode]');
        if (labels.length && io && !reduce) {
          const arm = () => {
            const dio = new IntersectionObserver((entries) => {
              for (const e of entries) if (e.isIntersecting) { decode(e.target as HTMLElement); dio.unobserve(e.target); }
            }, { threshold: 0.6 });
            labels.forEach((el) => dio.observe(el));
          };
          if (document.documentElement.classList.contains('is-loading')) document.addEventListener('cw:reveal', arm, { once: true });
          else arm();
        }
      });
    </script>
  </body>
</html>
