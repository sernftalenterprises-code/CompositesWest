---
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import { company } from '../data/products';

const nav = [
  { href: '/all-products/', label: 'Fabrics' },
  { href: '/applications/', label: 'Applications' },
  { href: '/material-finder/', label: 'Find material' },
  { href: '/hex-3r-products/', label: 'Hex-3R' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

/* Same file the header renders, as a CSS mask for the twill fill. */
const mask = await getImage({ src: logo, width: 504, format: 'png' });

const path = Astro.url.pathname;
/* Section landing pages also mark their child routes as current. */
const isCurrent = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-line data-[scrolled]:bg-carbon-950/85 data-[scrolled]:backdrop-blur-md"
>
  <!-- The tracer thread: runs the full width of every page -->
  <div class="relative h-0.5 bg-brand" aria-hidden="true">
    <span class="absolute left-1/2 top-0 h-2.5 w-px -translate-x-1/2 bg-brand"></span>
  </div>

  <div class="mx-auto flex h-16 max-w-[1600px] items-center justify-between gap-6 px-5 sm:px-8">
    <!-- "Twill" logo entrance: the silhouette fills with a drifting 2×2 twill,
         takes a pass of brand yellow, then resolves into the mark. -->
    <a href="/" id="logo-twill" class="relative block h-8 shrink-0 sm:h-9" aria-label="Composites West home" style={`--mask: url(${mask.src})`}>
      <span class="layer twill" aria-hidden="true"></span>
      <span class="layer tint" aria-hidden="true"></span>
      <Image src={logo} alt="Composites West, Inc." class="mark" loading="eager" fetchpriority="high" width={168} densities={[1, 2, 3]} />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'relative whitespace-nowrap py-2 font-display text-[12px] font-semibold uppercase tracking-[0.12em] transition-colors [font-variation-settings:"wdth"_115]',
            'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:bg-brand after:transition-transform after:duration-200',
            isCurrent(item.href)
              ? 'text-filament after:scale-x-100'
              : 'text-tow-500 after:scale-x-0 hover:text-filament hover:after:scale-x-100',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${company.phoneHref}`} class="eyebrow hidden text-tow-500 transition-colors hover:text-brand xl:block">
        {company.phone}
      </a>
      <a href="/contact/" class="btn btn-primary hidden !px-4 !py-2.5 lg:inline-flex">
        Request a quote
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex items-center gap-3 py-2 pl-2 font-display text-[12px] font-semibold uppercase tracking-[0.14em] text-filament [font-variation-settings:'wdth'_115] lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open main menu"
      >
        <span data-label>Menu</span>
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-px w-6 bg-filament"></span>
          <span class="block h-px w-6 bg-filament"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Full-screen mobile menu -->
  <div
    id="mobile-menu"
    class="hidden h-[calc(100dvh-66px)] overflow-y-auto border-t border-line bg-carbon-950 lg:hidden"
  >
    <nav aria-label="Mobile" class="flex min-h-full flex-col px-5 pb-8 pt-4 sm:px-8">
      {nav.map((item) => (
        <a
          href={item.href}
          class="group flex items-baseline justify-between border-b border-line py-5 type-display text-3xl text-filament"
        >
          {item.label}
          <span class="h-px w-6 bg-line-strong transition-all duration-200 group-hover:w-12 group-hover:bg-brand"></span>
        </a>
      ))}
      <div class="mt-auto pt-8">
        <a href="/contact/" class="btn btn-primary w-full">
          Request a quote <span class="btn-arrow">&rarr;</span>
        </a>
        <p class="eyebrow mt-6 flex justify-between text-tow-500">
          <a href={`tel:${company.phoneHref}`} class="hover:text-brand">{company.phone}</a>
          <span>Reno, NV</span>
        </p>
      </div>
    </nav>
  </div>
</header>

<style>
  #logo-twill { aspect-ratio: 569 / 122; }
  #logo-twill .mark { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  #logo-twill .layer {
    position: absolute; inset: 0; opacity: 0; pointer-events: none;
    -webkit-mask-image: var(--mask); mask-image: var(--mask);
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  }
  /* 2×2 twill at a scale that survives 36px tall */
  #logo-twill .twill {
    background-color: var(--color-carbon-800);
    background-image:
      repeating-linear-gradient(45deg, rgb(242 241 236 / 0) 0 3px, rgb(242 241 236 / 0.34) 3px 6px),
      repeating-linear-gradient(-45deg, rgb(5 5 6 / 0) 0 3px, rgb(5 5 6 / 0.6) 3px 6px),
      linear-gradient(90deg, var(--color-tow-700), var(--color-tow-300), var(--color-tow-700));
    background-size: 12px 12px, 12px 12px, 200% 100%;
  }
  #logo-twill .tint { background: var(--color-brand); mix-blend-mode: multiply; }
  @media (prefers-reduced-motion: no-preference) {
    #logo-twill[data-play] .twill { animation: twill-in 0.3s ease-out both, twill-drift 1.4s linear both, twill-out 0.4s ease-in 0.95s both; }
    #logo-twill[data-play] .tint { animation: twill-tint 0.6s ease-in-out 0.5s both; }
    #logo-twill[data-play] .mark { animation: twill-mark 0.5s ease-out 0.9s both; }
  }
  @keyframes twill-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes twill-drift { from { background-position: 0 0, 0 0, 0% 0; } to { background-position: 24px 24px, -24px 24px, 100% 0; } }
  @keyframes twill-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes twill-tint { 0% { opacity: 0; } 50% { opacity: 0.55; } 100% { opacity: 0; } }
  @keyframes twill-mark { from { opacity: 0; } to { opacity: 1; } }
</style>

<script>
  import { boot, reduceMotion } from '../scripts/boot';

  /* Header state is re-read from the live DOM on every call, so the single
     scroll listener keeps working across client-side navigations. */
  const onScroll = () => {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    if (!header) return;
    const scrolled = window.scrollY > 24 || toggle?.getAttribute('aria-expanded') === 'true';
    if (scrolled) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  boot('header', () => {
    /* Logo entrance plays once per browser session, not on every navigation. */
    const logoEl = document.getElementById('logo-twill');
    if (logoEl && !reduceMotion()) {
      let seen = false;
      try {
        seen = sessionStorage.getItem('cw-logo') === '1';
        sessionStorage.setItem('cw-logo', '1');
      } catch {}
      if (!seen) {
        const play = () => logoEl.setAttribute('data-play', '');
        // On the home page the preloader covers the header; start when it lifts.
        if (document.documentElement.classList.contains('is-loading')) {
          document.addEventListener('cw:reveal', play, { once: true });
        } else {
          play();
        }
      }
    }

    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const label = toggle?.querySelector('[data-label]');
    document.body.classList.remove('overflow-hidden');
    toggle?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
      document.body.classList.toggle('overflow-hidden', open);
      onScroll();
    });
    onScroll();
  });
</script><style>
