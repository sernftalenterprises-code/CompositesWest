---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { company } from '../data/products';

const nav = [
  { href: '/all-products/', label: 'Fabrics' },
  { href: '/applications/', label: 'Applications' },
  { href: '/material-finder/', label: 'Find material' },
  { href: '/hex-3r-products/', label: 'Hex-3R' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
/* Section landing pages also mark their child routes as current. */
const isCurrent = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-line data-[scrolled]:bg-carbon-950/85 data-[scrolled]:backdrop-blur-md"
>
  <!-- The tracer thread: runs the full width of every page -->
  <div class="relative h-0.5 bg-brand" aria-hidden="true">
    <span class="absolute left-1/2 top-0 h-2.5 w-px -translate-x-1/2 bg-brand"></span>
  </div>

  <div class="mx-auto flex h-16 max-w-[1600px] items-center justify-between gap-6 px-5 sm:px-8">
    <!-- "Spool" logo entrance: emblem seats, wordmark lays off it in six plies.
         Seven copies of one optimized image (one network fetch); the first is
         the emblem, the rest are horizontal ply bands clipped to the wordmark. -->
    <a href="/" id="logo-spool" class="relative block h-8 shrink-0 sm:h-9" aria-label="Composites West home">
      <Image src={logo} alt="" aria-hidden="true" class="ply emblem" loading="eager" fetchpriority="high" width={168} densities={[1, 2, 3]} />
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <Image src={logo} alt={i === 5 ? 'Composites West, Inc.' : ''} aria-hidden={i === 5 ? undefined : 'true'} class="ply band" style={`--i: ${i}`} loading="eager" width={168} densities={[1, 2, 3]} />
      ))}
      <span class="roller" aria-hidden="true"></span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'relative whitespace-nowrap py-2 font-display text-[12px] font-semibold uppercase tracking-[0.12em] transition-colors [font-variation-settings:"wdth"_115]',
            'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:bg-brand after:transition-transform after:duration-200',
            isCurrent(item.href)
              ? 'text-filament after:scale-x-100'
              : 'text-tow-500 after:scale-x-0 hover:text-filament hover:after:scale-x-100',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${company.phoneHref}`} class="eyebrow hidden text-tow-500 transition-colors hover:text-brand xl:block">
        {company.phone}
      </a>
      <a href="/contact/" class="btn btn-primary hidden !px-4 !py-2.5 lg:inline-flex">
        Request a quote
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex items-center gap-3 py-2 pl-2 font-display text-[12px] font-semibold uppercase tracking-[0.14em] text-filament [font-variation-settings:'wdth'_115] lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open main menu"
      >
        <span data-label>Menu</span>
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-px w-6 bg-filament"></span>
          <span class="block h-px w-6 bg-filament"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Full-screen mobile menu -->
  <div
    id="mobile-menu"
    class="hidden h-[calc(100dvh-66px)] overflow-y-auto border-t border-line bg-carbon-950 lg:hidden"
  >
    <nav aria-label="Mobile" class="flex min-h-full flex-col px-5 pb-8 pt-4 sm:px-8">
      {nav.map((item) => (
        <a
          href={item.href}
          class="group flex items-baseline justify-between border-b border-line py-5 type-display text-3xl text-filament"
        >
          {item.label}
          <span class="h-px w-6 bg-line-strong transition-all duration-200 group-hover:w-12 group-hover:bg-brand"></span>
        </a>
      ))}
      <div class="mt-auto pt-8">
        <a href="/contact/" class="btn btn-primary w-full">
          Request a quote <span class="btn-arrow">&rarr;</span>
        </a>
        <p class="eyebrow mt-6 flex justify-between text-tow-500">
          <a href={`tel:${company.phoneHref}`} class="hover:text-brand">{company.phone}</a>
          <span>Reno, NV</span>
        </p>
      </div>
    </nav>
  </div>
</header>

<style>
  #logo-spool { aspect-ratio: 569 / 122; }
  #logo-spool .ply { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  #logo-spool .emblem { clip-path: inset(0 79.5% 0 0); transform-origin: 10.2% 50%; }
  /* Six horizontal bands, each 1/6 of the height, clipped to the wordmark (right of the emblem). */
  #logo-spool .band { clip-path: inset(calc(var(--i) * 16.6%) 0 calc((5 - var(--i)) * 16.6%) 19.5%); }
  #logo-spool .roller {
    position: absolute; top: -6%; left: 19.5%; width: 2px; height: 112%;
    background: var(--color-brand); opacity: 0; transform: skewX(-18deg);
    box-shadow: 0 0 10px 1px rgba(255, 212, 0, 0.35);
  }
  @media (prefers-reduced-motion: no-preference) {
    #logo-spool[data-play] .emblem { animation: spool-seat 0.85s cubic-bezier(0.34, 1.4, 0.4, 1) both; }
    #logo-spool[data-play] .band { animation: spool-ply 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(0.5s + var(--i) * 0.08s); }
    #logo-spool[data-play] .roller { animation: spool-roll 0.95s cubic-bezier(0.4, 0, 0.2, 1) 0.55s both; }
  }
  @keyframes spool-seat { from { opacity: 0; transform: rotate(-150deg) scale(0.55); } 30% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes spool-ply { from { opacity: 0; transform: translateX(-16px); } to { opacity: 1; transform: none; } }
  @keyframes spool-roll { 0% { opacity: 1; left: 19.5%; } 85% { opacity: 1; } 100% { left: 102%; opacity: 0; } }
</style>

<script>
  import { boot, reduceMotion } from '../scripts/boot';

  /* Header state is re-read from the live DOM on every call, so the single
     scroll listener keeps working across client-side navigations. */
  const onScroll = () => {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    if (!header) return;
    const scrolled = window.scrollY > 24 || toggle?.getAttribute('aria-expanded') === 'true';
    if (scrolled) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  boot('header', () => {
    /* Logo entrance plays once per browser session, not on every navigation. */
    const spool = document.getElementById('logo-spool');
    if (spool && !reduceMotion()) {
      let seen = false;
      try {
        seen = sessionStorage.getItem('cw-spool') === '1';
        sessionStorage.setItem('cw-spool', '1');
      } catch {}
      if (!seen) {
        const play = () => spool.setAttribute('data-play', '');
        // On the home page the preloader covers the header; start when it lifts.
        if (document.documentElement.classList.contains('is-loading')) {
          document.addEventListener('cw:reveal', play, { once: true });
        } else {
          play();
        }
      }
    }

    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const label = toggle?.querySelector('[data-label]');
    document.body.classList.remove('overflow-hidden');
    toggle?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
      document.body.classList.toggle('overflow-hidden', open);
      onScroll();
    });
    onScroll();
  });
</script>
