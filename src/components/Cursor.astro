---
/**
 * Drafting-HUD cursor. A crosshair with a live coordinate readout that
 * follows the pointer; over anything interactive it snaps into a hairline
 * frame around the target. Fine-pointer devices only — touch never sees
 * it and text fields keep the native I-beam.
 */
---

<div id="cursor" class="cursor" aria-hidden="true">
  <span class="cursor-h"></span>
  <span class="cursor-v"></span>
  <span class="cursor-dot"></span>
  <span class="cursor-read" id="cursor-read">X 0000 · Y 0000</span>
</div>
<div id="cursor-frame" class="cursor-frame" aria-hidden="true">
  <i></i><i></i><i></i><i></i>
</div>

<script>
  import { boot, finePointer, reduceMotion } from '../scripts/boot';

  const SEL = 'a, button, summary, label, [role="button"], input[type="checkbox"], input[type="radio"]';

  boot('cursor', () => {
    const cur = document.getElementById('cursor');
    const frame = document.getElementById('cursor-frame');
    const read = document.getElementById('cursor-read');
    if (!cur || !frame || !read || !finePointer()) return;
    document.documentElement.classList.add('has-cursor');

    const instant = reduceMotion();
    let tx = -100, ty = -100, x = -100, y = -100;
    let target: Element | null = null;
    let raf = 0;
    let shown = false;

    const pad = (n: number) => String(Math.max(0, Math.round(n))).padStart(4, '0');

    const loop = () => {
      raf = 0;
      const k = instant ? 1 : 0.32;
      x += (tx - x) * k;
      y += (ty - y) * k;
      cur.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      if (Math.abs(tx - x) > 0.2 || Math.abs(ty - y) > 0.2) raf = requestAnimationFrame(loop);
    };

    const place = (el: Element) => {
      const r = el.getBoundingClientRect();
      const p = 6;
      frame.style.transform = `translate3d(${r.left - p}px, ${r.top - p}px, 0)`;
      frame.style.width = `${r.width + p * 2}px`;
      frame.style.height = `${r.height + p * 2}px`;
    };

    window.addEventListener('pointermove', (e) => {
      if (e.pointerType && e.pointerType !== 'mouse') return;
      tx = e.clientX; ty = e.clientY;
      if (!shown) { shown = true; cur.classList.add('is-on'); x = tx; y = ty; }
      read.textContent = `X ${pad(e.clientX)} · Y ${pad(e.clientY)}`;
      const hit = (e.target as Element | null)?.closest?.(SEL) ?? null;
      if (hit !== target) {
        target = hit;
        if (target) { place(target); frame.classList.add('is-on'); cur.classList.add('is-snapped'); }
        else { frame.classList.remove('is-on'); cur.classList.remove('is-snapped'); }
      } else if (target) place(target);
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });

    document.addEventListener('pointerleave', () => { cur.classList.remove('is-on'); shown = false; frame.classList.remove('is-on'); target = null; });
    window.addEventListener('scroll', () => { if (target) place(target); }, { passive: true });
    window.addEventListener('pointerdown', () => cur.classList.add('is-down'));
    window.addEventListener('pointerup', () => cur.classList.remove('is-down'));
  });
</script>
