---
/**
 * Live material view for the finder. Renders the construction of whichever
 * fabric currently ranks first — plain, 2×2 twill, 8H satin, unidirectional
 * or ±45° knit — at a tow scale derived from its tow count and areal weight,
 * lit with the same anisotropic sheen as the hero. When the winner changes
 * the weave cross-fades to the new one and the readout re-decodes.
 *
 * Listens for `cw:finder` events: detail { item | null, pct, answered }.
 */
---

<aside id="mview" class="mview relative overflow-hidden border border-line bg-carbon-950" aria-live="polite">
  <canvas id="mview-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-carbon-950 via-carbon-950/25 to-transparent" aria-hidden="true"></div>

  <!-- HUD top -->
  <div class="relative flex items-start justify-between gap-4 p-5">
    <p class="eyebrow flex items-center gap-3 text-tow-300"><span class="tag">View</span> <span id="mview-state">Awaiting input</span></p>
    <p class="eyebrow hidden text-right text-tow-500 sm:block"><span id="mview-weave">—</span></p>
  </div>

  <!-- Readout -->
  <div class="relative mt-auto p-5">
    <div class="mview-line mb-4 h-px w-full bg-line-strong"><span class="block h-full bg-brand" id="mview-fit-bar" style="width:0%"></span></div>
    <div class="flex items-end justify-between gap-4">
      <div class="min-w-0">
        <p class="eyebrow flex items-center gap-3 text-tow-500"><span id="mview-brand">—</span></p>
        <p id="mview-name" class="type-display mt-2 text-2xl leading-[0.95] text-filament sm:text-3xl">Answer a question</p>
        <p id="mview-spec" class="mt-3 font-mono text-[11px] uppercase leading-5 tracking-[0.12em] text-tow-300">The fabric appears here as the ranking forms.</p>
      </div>
      <div class="shrink-0 text-right">
        <p class="eyebrow text-tow-700">Fit</p>
        <p class="type-display text-4xl text-filament [font-variant-numeric:tabular-nums] sm:text-5xl"><span id="mview-fit">—</span><span class="text-lg text-tow-500">%</span></p>
      </div>
    </div>
  </div>
</aside>

<script>
  import { boot } from '../scripts/boot';

  type Item = { slug: string; shortName: string; brand: string; weave: string; weaveLabel: string; tow: string | null; weightGsm: number; weightOz: number; widthIn: number };

  const VERT = `attribute vec2 aPos; void main(){ gl_Position = vec4(aPos, 0.0, 1.0); }`;
  const FRAG = `
    precision highp float;
    uniform vec2  uRes;
    uniform float uTime;
    uniform vec2  uMouse;
    uniform float uWeaveA;   // 0 plain, 1 twill, 2 satin, 3 uni, 4 knit
    uniform float uWeaveB;
    uniform float uMix;      // 0 = A, 1 = B
    uniform float uDensA;
    uniform float uDensB;

    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

    bool warpTop(vec2 cell, float w){
      float i = cell.x, j = cell.y;
      if (w < 0.5) return mod(i + j, 2.0) < 1.0;
      if (w < 1.5) return mod(i + j, 4.0) < 2.0;
      if (w < 2.5) return mod(mod(i - 3.0 * j, 8.0) + 8.0, 8.0) < 1.0;
      if (w < 3.5) return true;
      return mod(i + j, 2.0) < 1.0;
    }

    vec3 weave(vec2 uv, float w, float dens, vec3 L1, vec3 L2){
      vec2 p = uv;
      if (w > 3.5) { float a = 0.7853982; p = mat2(cos(a), -sin(a), sin(a), cos(a)) * p; }   // ±45°
      p = p * dens + vec2(0.0, uTime * 0.02);
      vec2 cell = floor(p);
      vec2 f = fract(p);
      bool top = warpTop(cell, w);
      float tx = f.x * 2.0 - 1.0, ty = f.y * 2.0 - 1.0;
      float hWarp = sqrt(max(0.0, 1.0 - tx * tx));
      float hWeft = sqrt(max(0.0, 1.0 - ty * ty));
      // twill floats dip where the tow dives under
      float m = mod(cell.x + cell.y, 4.0);
      float dipWarp = (w > 0.5 && w < 1.5) ? mix(0.55, 1.0, sin(3.14159 * clamp((m + f.y) * 0.5, 0.0, 1.0))) : 1.0;
      float dipWeft = (w > 0.5 && w < 1.5) ? mix(0.55, 1.0, sin(3.14159 * clamp(((m - 2.0) + f.x) * 0.5, 0.0, 1.0))) : 1.0;
      float filWarp = 0.5 + 0.5 * sin(p.x * 150.0 + hash(vec2(cell.x, 1.0)) * 6.2831);
      float filWeft = 0.5 + 0.5 * sin(p.y * 150.0 + hash(vec2(1.0, cell.y)) * 6.2831);
      vec3 N; vec3 T; float h; float fil;
      if (top) { h = hWarp * dipWarp; N = normalize(vec3(-tx * 0.85, 0.0, hWarp + 0.3)); T = vec3(0.0, 1.0, 0.0); fil = filWarp; }
      else     { h = hWeft * dipWeft; N = normalize(vec3(0.0, -ty * 0.85, hWeft + 0.3)); T = vec3(1.0, 0.0, 0.0); fil = filWeft; }
      if (w > 3.5) { float a = -0.7853982; T = vec3(mat2(cos(a), -sin(a), sin(a), cos(a)) * T.xy, 0.0); N = vec3(mat2(cos(a), -sin(a), sin(a), cos(a)) * N.xy, N.z); }
      float gap = smoothstep(0.0, 0.22, h);
      vec3 V = vec3(0.0, 0.0, 1.0);
      float diff = max(dot(N, L1), 0.0) * 0.42 + max(dot(N, L2), 0.0) * 0.16;
      vec3 H1 = normalize(L1 + V); float th1 = dot(T, H1);
      vec3 H2 = normalize(L2 + V); float th2 = dot(T, H2);
      float spec = pow(sqrt(max(0.0, 1.0 - th1 * th1)), 110.0) * 1.35 + pow(sqrt(max(0.0, 1.0 - th2 * th2)), 60.0) * 0.28;
      spec *= 0.5 + 0.5 * fil;
      vec3 col = vec3(0.028, 0.028, 0.031) + vec3(0.075, 0.075, 0.082) * diff * (0.6 + 0.4 * fil) + vec3(0.58, 0.58, 0.62) * spec * h;
      return col * mix(0.18, 1.0, gap);
    }

    void main(){
      vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
      vec3 L1 = normalize(vec3((uMouse.x - 0.5) * 2.6, (uMouse.y - 0.5) * 1.8, 1.0));
      vec3 L2 = normalize(vec3(-0.7, 0.9, 0.8));
      vec3 a = weave(uv, uWeaveA, uDensA, L1, L2);
      vec3 b = weave(uv, uWeaveB, uDensB, L1, L2);
      // the new weave sweeps in along a diagonal wipe
      float edge = smoothstep(-0.15, 0.15, (uv.x + uv.y) * 0.5 + 0.9 - uMix * 1.8);
      vec3 col = mix(b, a, edge);
      col *= smoothstep(1.4, 0.4, length(uv * vec2(0.85, 1.0)));
      col += (hash(gl_FragCoord.xy + fract(uTime)) - 0.5) * 0.014;
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const WEAVE: Record<string, number> = { Plain: 0, Twill: 1, Satin: 2, Unidirectional: 3, Knit: 4 };
  const density = (it: Item | null) => {
    if (!it) return 17;
    const towK = it.tow ? parseFloat(it.tow) : 6;
    const base = towK >= 12 ? 11 : towK >= 6 ? 14.5 : 18;
    return Math.max(9, Math.min(22, base * Math.pow(197 / it.weightGsm, 0.3)));
  };

  const CH = '0123456789ABCDEFX/·—';
  const decode = (el: HTMLElement, final: string) => {
    const n = final.length, t0 = performance.now(), dur = 380 + n * 10;
    const step = (now: number) => {
      const p = Math.min((now - t0) / dur, 1), k = Math.floor(p * n);
      let out = '';
      for (let i = 0; i < n; i++) out += i < k || final[i] === ' ' ? final[i] : CH[(Math.random() * CH.length) | 0];
      el.textContent = p < 1 ? out : final;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  boot('mview', '#mview-canvas', () => {
    const root = document.getElementById('mview')!;
    const canvas = document.getElementById('mview-canvas') as HTMLCanvasElement;
    const els = {
      state: document.getElementById('mview-state')!, weave: document.getElementById('mview-weave')!,
      brand: document.getElementById('mview-brand')!, name: document.getElementById('mview-name')!,
      spec: document.getElementById('mview-spec')!, fit: document.getElementById('mview-fit')!,
      bar: document.getElementById('mview-fit-bar')!,
    };
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover)').matches;

    const gl = canvas.getContext('webgl', { antialias: false, alpha: false }) as WebGLRenderingContext | null;
    if (!gl) { root.classList.add('twill'); canvas.remove(); }
    let draw = (_t: number) => {};
    let mixTarget = 1, mixNow = 1;
    let wA = 1, wB = 1, dA = 17, dB = 17;

    if (gl) {
      const compile = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(s)); return null; } return s; };
      const vs = compile(gl.VERTEX_SHADER, VERT), fs = compile(gl.FRAGMENT_SHADER, FRAG);
      if (vs && fs) {
        const prog = gl.createProgram()!;
        gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog); gl.useProgram(prog);
        const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const aPos = gl.getAttribLocation(prog, 'aPos'); gl.enableVertexAttribArray(aPos); gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
        const u = (n: string) => gl.getUniformLocation(prog, n);
        const U = { res: u('uRes'), time: u('uTime'), mouse: u('uMouse'), wA: u('uWeaveA'), wB: u('uWeaveB'), mix: u('uMix'), dA: u('uDensA'), dB: u('uDensB') };
        let w = 0, h = 0;
        const resize = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          const r = root.getBoundingClientRect();
          w = Math.max(1, Math.round(r.width * dpr)); h = Math.max(1, Math.round(r.height * dpr));
          if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h); }
        };
        resize(); window.addEventListener('resize', resize, { passive: true });
        const target = { x: 0.62, y: 0.6 }, mouse = { x: 0.62, y: 0.6 };
        if (canHover && !reduceMotion) window.addEventListener('pointermove', (e) => { target.x = e.clientX / window.innerWidth; target.y = 1 - e.clientY / window.innerHeight; }, { passive: true });
        draw = (t) => {
          if (!canHover) { target.x = 0.5 + 0.35 * Math.cos(t * 0.25); target.y = 0.55 + 0.25 * Math.sin(t * 0.19); }
          mouse.x += (target.x - mouse.x) * 0.06; mouse.y += (target.y - mouse.y) * 0.06;
          mixNow += (mixTarget - mixNow) * (reduceMotion ? 1 : 0.08);
          gl.uniform2f(U.res, w, h); gl.uniform1f(U.time, t); gl.uniform2f(U.mouse, mouse.x, mouse.y);
          gl.uniform1f(U.wA, wA); gl.uniform1f(U.wB, wB); gl.uniform1f(U.mix, mixNow);
          gl.uniform1f(U.dA, dA); gl.uniform1f(U.dB, dB);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
        };
      }
    }

    let visible = true, raf = 0;
    const t0 = performance.now();
    const frame = (now: number) => { raf = 0; if (!visible) return; draw((now - t0) / 1000); if (!reduceMotion || Math.abs(mixTarget - mixNow) > 0.001) raf = requestAnimationFrame(frame); };
    if ('IntersectionObserver' in window) new IntersectionObserver((en) => { visible = en[0].isIntersecting; if (visible && !raf) raf = requestAnimationFrame(frame); }, { threshold: 0 }).observe(root);
    raf = requestAnimationFrame(frame);

    let current: string | null = null;
    const show = (item: Item | null, pct: number, answered: number) => {
      const key = item ? item.slug : null;
      if (key !== current) {
        // the fabric on screen becomes A, the new one B, and the wipe runs A → B
        wA = wB; dA = dB;
        wB = item ? WEAVE[item.weave] ?? 1 : 1; dB = density(item);
        mixNow = 0; mixTarget = 1;
        current = key;
        if (item) decode(els.name, item.shortName);
        else els.name.textContent = 'Answer a question';
        if (!raf) raf = requestAnimationFrame(frame);
      }
      if (item) {
        els.state.textContent = answered < 4 ? `Leading · ${answered}/4 answered` : 'Best match';
        els.weave.textContent = item.weaveLabel;
        els.brand.textContent = item.brand;
        els.spec.textContent = [item.tow ? `${item.tow} tow` : null, `${item.weightGsm} gsm · ${item.weightOz} oz`, `${item.widthIn} in`].filter(Boolean).join(' · ');
        els.fit.textContent = String(Math.round(pct));
        els.bar.style.width = `${Math.round(pct)}%`;
      } else {
        els.state.textContent = 'Awaiting input'; els.weave.textContent = '—'; els.brand.textContent = '—';
        els.spec.textContent = 'The fabric appears here as the ranking forms.'; els.fit.textContent = '—'; els.bar.style.width = '0%';
      }
    };
    document.addEventListener('cw:finder', (e) => { const d = (e as CustomEvent).detail; show(d.item ?? null, d.pct ?? 0, d.answered ?? 0); });
  });
</script>
