---
import { company } from '../data/products';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Send us the part. We’ll send back the material.',
  text = 'Spec, application, or a photo of what you’re building — our sales engineers match it to what’s on the shelf and quote it the same day.',
} = Astro.props;
---

<section class="twill cv-auto relative overflow-hidden border-t border-line">
  <div class="frame-x frame-dark relative mx-auto max-w-[1600px] px-5 sm:px-8">
    <span class="crosshair left-5 top-8 sm:left-8" aria-hidden="true"></span>
    <span class="crosshair bottom-8 right-5 sm:right-8" aria-hidden="true"></span>
    <div class="grid gap-10 py-24 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow flex items-center gap-3 text-brand">
          <span class="tag">Quote</span> Same-day response on in-stock material
        </p>
        <h2 class="type-display mt-6 text-4xl text-filament sm:text-5xl lg:text-6xl">{heading}</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-tow-300">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
        <a href="/contact/" class="btn btn-primary">
          Request a quote <span class="btn-arrow">&rarr;</span>
        </a>
        <a href={`tel:${company.phoneHref}`} class="btn btn-outline">
          {company.phone}
        </a>
      </div>
    </div>
  </div>
</section>
