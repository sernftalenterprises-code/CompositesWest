---
import { company } from '../data/products';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Tell us what you are building.',
  text = 'Talk to our sales team about availability, pricing, and the right reinforcement for your application.',
} = Astro.props;
---

<section class="cv-auto relative bg-white print:hidden">
  <div class="frame-x relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col items-start gap-8 py-20 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow text-stone-500">Get in touch</p>
        <h2 class="type-display mt-4 text-3xl text-ink-950 sm:text-4xl">{heading}</h2>
        <div class="tracer mt-5"></div>
        <p class="mt-5 text-lg leading-8 text-stone-600">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-dark">
          Contact us
        </a>
        <a href={`tel:${company.phoneHref}`} class="btn btn-outline">
          {company.phone}
        </a>
      </div>
    </div>
  </div>
</section>
